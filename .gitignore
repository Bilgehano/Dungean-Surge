# =============== #
#  Unity .gitignore
# =============== #

# Library — regenerated locally from Assets & Packages
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]serSettings/

# MemoryCaptures
/[Mm]emoryCaptures/

# Recordings
/[Rr]ecordings/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Crash Report
sysinfo.txt

# Build results
*.apk
*.aab
*.unitypackage
*.app

# Nuget
*.nupkg

# ============================================ #
#  Visual Studio / Rider / IDE files
# ============================================ #
.vs/
.vscode/
*.csproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
UpgradeLog.htm

# JetBrains Rider
.idea/
*.sln.iml

# Visual Studio Code
*.code-workspace

# ============================================ #
#  OS-generated files
# ============================================ #

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon?
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# Linux
*~

# ============================================ #
#  Unity-specific caches & generated files
# ============================================ #

# Gradle cache (Android builds)
.gradle/

# TextMesh Pro
/[Aa]ssets/TextMesh Pro/

# Plastic SCM (Unity Version Control)
ignore.conf
*.private.0
*.private

# Crashlytics
crashlytics-build.properties

# Addressables
/[Aa]ssets/AddressableAssetsData/*/*.bin*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Unity 6 specific
/[Aa]ssets/[Ss]treamingAssets/UnityServicesProjectConfiguration.json
/[Aa]ssets/[Ss]treamingAssets/UnityServicesProjectConfiguration.json.meta
